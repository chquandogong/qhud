{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "qhud main widget window: drag-move, grip-resize, report events, persisted geometry",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "window-state:default"
  ]
}
