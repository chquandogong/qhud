new file mode 100644
--- /dev/null
+++ b/src/process.rs
@@ -0,0 +1,22 @@
+//! Process setup shared by the terminal and desktop front ends.
+
+use std::ffi::OsStr;
+use std::process::Command;
+
+/// Background probes must not create a console window when the library is
+/// hosted by a Windows GUI. Other platforms retain the standard behavior.
+pub(crate) fn command(program: impl AsRef<OsStr>) -> Command {
+    let mut command = Command::new(program);
+    configure(&mut command);
+    command
+}
+
+#[cfg(windows)]
+fn configure(command: &mut Command) {
+    use std::os::windows::process::CommandExt;
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    command.creation_flags(CREATE_NO_WINDOW);
+}
+
+#[cfg(not(windows))]
+fn configure(_command: &mut Command) {}
